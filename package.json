{
  "name": "@ar-js-org/arjs-plugin-artoolkit",
  "version": "0.3.0",
  "description": "ARToolKit detection plugin for AR.js core (ECS plugin)",
  "type": "module",
  "main": "dist/arjs-plugin-artoolkit.es.js",
  "module": "dist/arjs-plugin-artoolkit.es.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/arjs-plugin-artoolkit.es.js",
      "require": "./dist/arjs-plugin-artoolkit.es.js"
    }
  },
  "files": [
    "dist",
    "types",
    "!**/*.map"
  ],
  "scripts": {
    "build": "vite build",
    "build:types": "tsc --emitDeclarationOnly",
    "check:package": "npm run build && npm run build:types && node dev/check-package-contents.mjs",
    "prepublishOnly": "npm run build && npm run build:types",
    "coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "lint": "eslint .",
    "prepare": "husky",
    "smoke:node": "node dev/smoke-node.js",
    "smoke:browser": "npx http-server -p 8080"
  },
  "keywords": [
    "arjs",
    "artoolkit",
    "artoolkit5",
    "augmented-reality",
    "esmodule",
    "marker",
    "marker-detection",
    "plugin",
    "tracking",
    "wasm",
    "webworker",
    "worker"
  ],
  "author": "Walter Perdan @kalwalt https://github.com/kalwalt",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AR-js-org/arjs-plugin-artoolkit.git"
  },
  "bugs": {
    "url": "https://github.com/AR-js-org/arjs-plugin-artoolkit/issues"
  },
  "homepage": "https://github.com/AR-js-org/arjs-plugin-artoolkit#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@ar-js-org/artoolkit5-ts": "^0.3.0"
  }
}
